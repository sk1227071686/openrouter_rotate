{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "1",
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "FABLE[1M]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "cohere/north-mini-code:free",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "HAIKU",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "OPS[1M]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "cohere/north-mini-code:free",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "SONNET",
    "ANTHROPIC_MODEL": "cohere/north-mini-code:free",
    "ANTHROPIC_REASONING_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "model": "sonnet",
  "permissions": {
	  "deny": ["Read(.env*)"]
  },
  "enabledPlugins": {
    "ralph-wiggum@claude-code-plugins": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "experimental": {
    "agentTeams": true
  }
}
